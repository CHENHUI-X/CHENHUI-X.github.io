---
import { articleTopics } from "@constants/article-topics";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const totalArticles = articleTopics.reduce(
	(sum, topic) => sum + topic.articles.length,
	0,
);
---
<MainGridLayout title="主题目录" description="按问题组织全部文章：LLM 入门、深入专题、应用部署、数学基础与因果推断。">
    <article class="card-base p-6 md:p-9 mb-4 text-black/75 dark:text-white/75" data-topic-directory>
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90 flex items-center gap-2.5">
                <span class="w-1.5 h-6 rounded-full bg-[var(--primary)]"></span>
                文章主题目录
            </h1>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[var(--btn-regular-bg)] text-[var(--primary)] tabular-nums">
                共 {articleTopics.length} 个专题 · {totalArticles} 篇文章
            </span>
        </div>

        <p class="text-sm md:text-[0.95rem] text-black/60 dark:text-white/60 mb-4 leading-relaxed">
            这里按技术问题整理了全部文章。若想按时间顺序查看近期更新，可前往
            <a class="text-[var(--primary)] font-medium hover:underline underline-offset-4" href="/archive/">时间归档 →</a>
        </p>

        <!-- Featured Roadmap Banner -->
        <div class="mb-6 p-4 rounded-xl border border-[var(--primary)]/20 bg-[var(--btn-regular-bg)]/55 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-9 h-9 rounded-lg bg-[var(--primary)] text-white flex items-center justify-center shrink-0 shadow-sm">
                    <Icon name="material-symbols:route-outline" class="text-lg" />
                </div>
                <div class="text-sm leading-relaxed">
                    <span class="font-bold text-black/85 dark:text-white/85">第一次系统学习 LLM？</span>
                    <span class="text-black/60 dark:text-white/60 ml-1">推荐先走通 9 步主线，进阶专题遇到实际问题再按需查阅。</span>
                </div>
            </div>
            <a class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-lg bg-[var(--primary)] text-white text-xs font-semibold shadow-sm hover:brightness-105 active:scale-95 transition-[transform,filter] duration-200 shrink-0" href="/posts/2026-06-03-llm-knowledge-map/">
                9 步入门路线
                <Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
            </a>
        </div>

        <!-- Topic Jump Index -->
        <nav aria-label="主题索引" class="flex flex-wrap gap-2 mb-9 pb-6 border-b border-black/[0.06] dark:border-white/[0.08]">
            {articleTopics.map((topic) => (
                <a
                    class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-black/[0.035] dark:bg-white/[0.05] text-black/75 dark:text-white/75 hover:bg-[var(--btn-regular-bg)] hover:text-[var(--primary)] border border-transparent hover:border-[var(--primary)]/25 transition-[transform,background-color,color,border-color] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5"
                    href={`#${topic.id}`}
                >
                    <span>{topic.title}</span>
                    <span class="text-[0.7rem] px-1.5 py-0.2 rounded-full bg-black/[0.05] dark:bg-white/[0.08] text-black/45 dark:text-white/45 group-hover:bg-[var(--primary)]/15 group-hover:text-[var(--primary)] tabular-nums transition-colors">
                        {topic.articles.length}
                    </span>
                </a>
            ))}
        </nav>

        <!-- Topic Sections -->
        <div class="space-y-10">
            {articleTopics.map((topic) => (
                <section id={topic.id} class="scroll-mt-24" data-topic-group={topic.id}>
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <h2 class="text-xl md:text-[1.35rem] font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[var(--primary)]"></span>
                            {topic.title}
                        </h2>
                        <span class="text-xs text-black/40 dark:text-white/40 tabular-nums">{topic.articles.length} 篇</span>
                    </div>
                    <p class="text-sm text-black/55 dark:text-white/55 mb-4 pl-4 leading-relaxed">{topic.description}</p>

                    <ol class="grid gap-2.5">
                        {topic.articles.map((article, index) => (
                            <li class="group relative rounded-xl border border-black/[0.06] dark:border-white/[0.07] bg-black/[0.015] dark:bg-white/[0.02] hover:bg-[var(--btn-plain-bg-hover)] hover:border-[var(--primary)]/35 p-3.5 md:px-4 transition-[transform,background-color,border-color,box-shadow] duration-220 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5">
                                <div class="flex items-start gap-3">
                                    <span
                                        class="w-6 h-6 rounded-md bg-[var(--btn-regular-bg)] text-[var(--primary)] text-xs font-bold flex items-center justify-center shrink-0 mt-0.5 tabular-nums transition-colors duration-200 group-hover:bg-[var(--primary)] group-hover:text-white"
                                        aria-label={topic.id === "llm-memory" ? `第 ${index + 1} 篇` : undefined}
                                    >
                                        {index + 1}
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <a
                                            class="font-bold text-[0.95rem] text-black/85 dark:text-white/85 group-hover:text-[var(--primary)] transition-colors after:absolute after:inset-0 flex items-center justify-between gap-2"
                                            href={getPostUrlBySlug(article.slug)}
                                            data-topic-article
                                        >
                                            <span>{article.title}</span>
                                            <Icon name="material-symbols:chevron-right-rounded" class="text-lg text-black/25 dark:text-white/25 group-hover:text-[var(--primary)] group-hover:translate-x-0.5 transition-[transform,color] duration-200 shrink-0" />
                                        </a>
                                        <p class="text-xs md:text-[0.825rem] text-black/55 dark:text-white/55 mt-1 leading-relaxed">
                                            {article.purpose}
                                        </p>
                                    </div>
                                </div>
                            </li>
                        ))}
                    </ol>

                    {topic.id === "llm-memory" && (
                        <p class="mt-3 pl-4 text-xs md:text-sm text-black/55 dark:text-white/55">
                            相关补充：<a class="text-[var(--primary)] font-medium hover:underline underline-offset-4" href="/posts/2026-05-16-llm-quantization-guide/">量化专题：INT4、GPTQ 与 AWQ</a> 单独保留，按需要配合阅读。
                        </p>
                    )}
                </section>
            ))}
        </div>
    </article>
</MainGridLayout>
