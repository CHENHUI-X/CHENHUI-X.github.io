---
import { articleTopics } from "@constants/article-topics";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "@utils/url-utils";
---
<MainGridLayout title="主题目录" description="按问题组织全部文章：LLM 入门、深入专题、应用部署、数学基础与因果推断。">
    <article class="card-base p-6 md:p-9 mb-4 text-black/75 dark:text-white/75" data-topic-directory>
        <h1 class="text-3xl font-bold mb-4">文章分类</h1>
        <p class="mb-3">这里按主题整理了全部文章。查看近期发布的内容，可以浏览<a class="text-[var(--primary)] hover:underline" href="/archive/">时间归档</a>。</p>
        <p class="mb-6">第一次系统学 LLM？从<a class="text-[var(--primary)] hover:underline" href="/posts/2026-06-03-llm-knowledge-map/">知识地图的 9 步入门路线</a>开始。深入专题可以等遇到问题时再读。</p>
        <nav aria-label="主题索引" class="flex flex-wrap gap-3 mb-8">
            {articleTopics.map((topic) => <a class="px-3 py-2 rounded-lg bg-black/5 dark:bg-white/5 text-[var(--primary)]" href={`#${topic.id}`}>{topic.title}</a>)}
        </nav>
        {articleTopics.map((topic) => <section id={topic.id} class="mb-10 scroll-mt-24" data-topic-group={topic.id}>
            <h2 class="text-2xl font-bold mb-2">{topic.title}</h2>
            <p class="mb-4 text-black/60 dark:text-white/60">{topic.description}</p>
            <ol class="grid gap-4">
                {topic.articles.map((article, index) => <li class="border-l-2 border-[var(--primary)] pl-4">
                    <a class="font-bold text-[var(--primary)] hover:underline" href={getPostUrlBySlug(article.slug)} data-topic-article>{topic.id === "llm-memory" && <span class="mr-2" aria-label={`第 ${index + 1} 篇`}>{index + 1}.</span>}{article.title}</a>
                    <p class="text-sm mt-1">{article.purpose}</p>
                </li>)}
            </ol>
            {topic.id === "llm-memory" && <p class="mt-4 text-sm">相关补充：<a class="text-[var(--primary)] hover:underline" href="/posts/2026-05-16-llm-quantization-guide/">量化专题：INT4、GPTQ 与 AWQ</a>单独保留，按需要配合阅读。</p>}
        </section>)}
    </article>
</MainGridLayout>
