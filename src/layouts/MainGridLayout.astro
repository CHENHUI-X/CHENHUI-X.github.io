---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-[height] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div
    class:list={[
        "w-full z-30 pointer-events-none",
        siteConfig.banner.enable ? "absolute" : "relative mt-4",
    ]}
    style={siteConfig.banner.enable ? `top: ${mainPanelTop}` : undefined}
>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] w-full left-0 right-0 grid grid-cols-[14rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-[padding,background-color] absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <div id="toc-left-wrapper"
                 class:list={["hidden lg:block mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[14rem] onload-animation"]}
            >
                {!isPostsRoute && (
                    <SideBar class="" headings={headings}></SideBar>
                )}
                {isPostsRoute && headings.length > 0 && (
                    <div id="toc-left-inner" class="sticky top-24 transition-swup-fade">
                        <div class="card-base !overflow-visible">
                            <div id="toc-left-scroll" class="overflow-y-auto max-h-[calc(100vh-10rem)] hide-scrollbar px-3 md:px-4 py-4 relative">
                                <TOC headings={headings} />
                            </div>
                        </div>
                    </div>
                )}
            </div>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>
    </div>
</div>

<!-- #toc 空占位：供 Swup SPA 导航使用，必须始终存在 -->
<div id="toc" style="display:none"></div>

<!-- ===== 移动端 TOC ===== -->
{isPostsRoute && headings.length > 0 && (
  <>
  <!-- 悬浮按钮（无 backdrop-filter，完美适配暗黑模式） -->
  <button id="mobile-toc-btn"
    type="button"
    class="mobile-toc-fab fixed bottom-6 right-5 z-[45] lg:hidden flex items-center justify-center w-11 h-11 rounded-full cursor-pointer select-none active:scale-95"
    aria-label="文章目录"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="8" y1="6" x2="21" y2="6" />
      <line x1="8" y1="12" x2="21" y2="12" />
      <line x1="8" y1="18" x2="21" y2="18" />
      <line x1="3" y1="6" x2="3.01" y2="6" />
      <line x1="3" y1="12" x2="3.01" y2="12" />
      <line x1="3" y1="18" x2="3.01" y2="18" />
    </svg>
  </button>

  <!-- 抽屉遮罩 -->
  <div id="mobile-toc-overlay"
    class="fixed inset-0 z-[48] lg:hidden"
    style="background:rgba(15, 23, 42, 0.42);opacity:0;pointer-events:none;transition:opacity 0.25s ease"
  >
    <!-- 抽屉面板 -->
    <div id="mobile-toc-panel"
      class="absolute right-0 top-0 h-full shadow-2xl"
      style="width:85vw;max-width:320px;background:var(--surface-elevated);border-left:1px solid var(--border-subtle);transform:translateX(100%);transition:transform 0.3s cubic-bezier(0.22,1,0.36,1)"
    >
      <!-- 头部 -->
      <div class="flex items-center justify-between px-5 py-4"
        style="border-bottom:1px solid var(--border-subtle)"
      >
        <span class="inline-flex items-center gap-2 font-bold text-base" style="color:var(--primary)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6" />
            <line x1="8" y1="12" x2="21" y2="12" />
            <line x1="8" y1="18" x2="21" y2="18" />
            <line x1="3" y1="6" x2="3.01" y2="6" />
            <line x1="3" y1="12" x2="3.01" y2="12" />
            <line x1="3" y1="18" x2="3.01" y2="18" />
          </svg>
          <span>目录</span>
        </span>
        <button id="mobile-toc-close"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-lg cursor-pointer select-none text-[var(--text-50)] hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] transition-colors duration-150"
          aria-label="关闭目录"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <!-- 列表 -->
      <div id="mobile-toc-list"
        class="overflow-y-auto px-3 py-2"
        style="height:calc(100% - 3.5rem)"
      ></div>
    </div>
  </div>
  </>
)}

<style>
.mobile-toc-fab {
  background: var(--surface-elevated);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--card-highlight), 0 4px 16px -2px rgba(15, 23, 42, 0.14);
  color: var(--primary);
  -webkit-tap-highlight-color: transparent;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease, border-color 180ms ease;
}
:global(:root.dark) .mobile-toc-fab {
  box-shadow: var(--card-highlight), 0 6px 20px rgba(0, 0, 0, 0.44);
}
</style>

<script is:inline>
(function(){'use strict';
  if (window.__mobileTocInited) return;
  window.__mobileTocInited = true;

  var activeBtn = null;
  var activeOverlay = null;

  function closeDrawer() {
    if (!activeOverlay) return;
    activeOverlay.style.opacity = '0';
    activeOverlay.style.pointerEvents = 'none';
    var panel = activeOverlay.querySelector('#mobile-toc-panel');
    if (panel) panel.style.transform = 'translateX(100%)';
  }

  function openDrawer() {
    if (!activeOverlay) return;
    activeOverlay.style.opacity = '1';
    activeOverlay.style.pointerEvents = 'auto';
    var panel = activeOverlay.querySelector('#mobile-toc-panel');
    if (panel) panel.style.transform = 'translateX(0)';
  }

  function syncMobileToc() {
    // 清理上一页残留到 body 下的旧实例
    if (activeBtn && document.body.contains(activeBtn) && !document.querySelector('#content-layer #mobile-toc-btn')) {
      activeBtn.remove();
    }
    if (activeOverlay && document.body.contains(activeOverlay) && !document.querySelector('#content-layer #mobile-toc-overlay')) {
      activeOverlay.remove();
    }

    var newBtn = document.querySelector('#content-layer #mobile-toc-btn');
    var newOverlay = document.querySelector('#content-layer #mobile-toc-overlay');
    if (newBtn && newOverlay) {
      if (activeBtn && activeBtn !== newBtn) activeBtn.remove();
      if (activeOverlay && activeOverlay !== newOverlay) activeOverlay.remove();
      document.body.appendChild(newBtn);
      document.body.appendChild(newOverlay);
      activeBtn = newBtn;
      activeOverlay = newOverlay;

      var cb = activeOverlay.querySelector('#mobile-toc-close');
      activeBtn.onclick = openDrawer;
      if (cb) cb.onclick = closeDrawer;
      activeOverlay.onclick = function (e) { if (e.target === activeOverlay) closeDrawer(); };
    } else {
      if (activeBtn) { activeBtn.remove(); activeBtn = null; }
      if (activeOverlay) { activeOverlay.remove(); activeOverlay = null; }
      return;
    }

    var list = activeOverlay.querySelector('#mobile-toc-list');
    if (!list) return;

    var all = document.querySelectorAll('#post-container h2, #post-container h3');
    if (all.length < 2 || window.innerWidth >= 1024) {
      activeBtn.style.display = 'none';
      return;
    }
    activeBtn.style.display = 'flex';
    list.innerHTML = '';

    all.forEach(function (h) {
      var id = h.id || h.textContent.trim().toLowerCase().replace(/[^\w\u4e00-\u9fff]+/g, '-');
      if (!h.id) h.id = id;
      var a = document.createElement('a');
      a.href = '#' + id;
      a.className = 'block py-2.5 px-3 rounded-lg text-sm transition-colors hover:bg-[var(--toc-btn-hover)]';
      a.style.cssText = 'color:var(--text-75);text-decoration:none;' + (h.tagName === 'H3' ? 'padding-left:1.5rem;' : '');
      a.textContent = (h.textContent || '').replace(/#$/, '').trim();
      a.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        closeDrawer();
        setTimeout(function () {
          var el = document.getElementById(id);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 280);
      });
      list.appendChild(a);
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeDrawer();
  });

  function bindSwup() {
    if (window.swup && window.swup.hooks) {
      window.swup.hooks.on('content:replace', closeDrawer);
      window.swup.hooks.on('page:view', syncMobileToc);
    }
  }

  if (window.swup) {
    bindSwup();
  } else {
    document.addEventListener('swup:enable', bindSwup);
  }
  syncMobileToc();
})();
</script>

</Layout>


