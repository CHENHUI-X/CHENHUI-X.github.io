---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<div class="border-t border-[var(--border-subtle)] my-10 border-dashed mx-16 md:mx-32"></div>
<div class="rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="text-50 text-xs md:text-sm text-center tabular-nums">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}
        <span class="mx-2 opacity-35">·</span>
        <a class="link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a>
        <span class="mx-2 opacity-35">·</span>
        <a class="link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
         <span class="mx-2 opacity-35">·</span>
         <a class="link text-[var(--primary)] font-medium" data-no-swup href={`${url('/')}?gate=1`}>重温扉页</a>
    </div>
    <div class="text-xs text-[var(--secondary)] mt-2 flex gap-4 items-center justify-center tabular-nums">
        <span id="busuanzi_container_site_uv">
            访客数: <span id="busuanzi_value_site_uv"></span>
        </span>
        <span id="busuanzi_container_site_pv">
            访问量: <span id="busuanzi_value_site_pv"></span>
        </span>
    </div>
</div>
