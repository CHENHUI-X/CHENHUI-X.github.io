---
import { icons } from "@iconify-json/material-symbols";
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import type { NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const navIcon = (name: string) => ({
	width: icons.width,
	height: icons.height,
	...icons.icons[name],
});

const links = navBarConfig.links.map((item): NavBarLink => {
	const link = typeof item === "number" ? LinkPresets[item] : item;
	return { target: link.external ? "_blank" : undefined, ...link };
});
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between gap-2 px-3 lg:px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-2.5 lg:px-3 font-bold active:scale-95 whitespace-nowrap shrink-0">
            <div class="flex flex-row text-[var(--primary)] items-center text-md tracking-tight whitespace-nowrap">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.65rem] mb-0.5 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden lg:flex items-center gap-0.5 shrink-0">
            {links.map((l) => {
                const linkHref = l.external ? l.url : url(l.url);
                return <a aria-label={l.name} href={linkHref} target={l.target}
                          data-nav-link={l.external ? undefined : linkHref}
                          class="nav-item-link btn-plain scale-animation rounded-lg h-10 font-bold px-2.5 xl:px-3 text-[0.875rem] active:scale-95 relative whitespace-nowrap shrink-0"
                >
                    <div class="flex items-center whitespace-nowrap">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.7rem] transition -translate-y-[1px] ml-1 text-black/25 dark:text-white/25"></Icon>}
                    </div>
                    {!l.external && <span class="nav-active-bar" aria-hidden="true"></span>}
                </a>;
            })}
        </div>
        <div class="flex items-center gap-0.5 shrink-0">
            <Search client:load searchIcon={navIcon("search")}></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-[var(--radius-btn)] h-10 w-10 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:load icons={{
                light: navIcon("wb-sunny-outline-rounded"),
                dark: navIcon("dark-mode-outline-rounded"),
                auto: navIcon("radio-button-partial-outline"),
            }}></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-[var(--radius-btn)] w-10 h-10 active:scale-90 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <div class="contents" id="settings-island"><DisplaySettings client:only="svelte"></DisplaySettings></div>
    </div>
</div>

<script is:inline>
    document.getElementById("navbar").onclick = (event) => {
        const button = event.target.closest?.("button");
        if (!button) return;
        if (button.id === "nav-menu-switch") {
            document.getElementById("nav-menu-panel").classList.toggle("float-panel-closed");
        } else if (button.id === "display-settings-switch") {
            const panel = document.getElementById("display-setting");
            if (panel) {
                panel.classList.toggle("float-panel-closed");
            } else {
                document.getElementById("settings-island").addEventListener("astro:hydrate", () => button.click(), { once: true, capture: true });
            }
        } else {
            // The SSR control can receive a click while its Svelte handlers are downloading.
            button.closest("astro-island[ssr]")?.addEventListener("astro:hydrate", () => button.click(), { once: true });
        }
    };
</script>

<style>
    .nav-active-bar {
        position: absolute;
        bottom: 4px;
        left: 50%;
        width: 1.15rem;
        height: 2.5px;
        border-radius: 9999px;
        background: var(--primary);
        transform: translateX(-50%) scaleX(0);
        opacity: 0;
        transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
    }
    .nav-item-link.is-active {
        color: var(--primary) !important;
    }
    .nav-item-link.is-active .nav-active-bar {
        transform: translateX(-50%) scaleX(1);
        opacity: 1;
    }
</style>

<script>
function normalizePath(p: string) {
    try {
        const u = new URL(p, window.location.origin);
        return u.pathname.replace(/\/+$/, '') || '/';
    } catch {
        return p.replace(/\/+$/, '') || '/';
    }
}

function updateActiveNavLink(targetUrl?: string) {
    const currentPath = normalizePath(targetUrl || window.location.pathname);
    const isPaginationHome = /^\/\d+$/.test(currentPath);
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('#navbar a[data-nav-link]');
    navLinks.forEach((el) => {
        const linkPath = normalizePath(el.dataset.navLink || '');
        const matched =
            linkPath === '/'
                ? currentPath === '/' || isPaginationHome
                : currentPath === linkPath;
        el.classList.toggle('is-active', matched);
    });
}

updateActiveNavLink();

const bindSwupNavSync = () => {
    window.swup.hooks.on('visit:start', (visit: { to: { url: string } }) => {
        updateActiveNavLink(visit.to.url);
    });
    window.swup.hooks.on('page:view', () => {
        updateActiveNavLink();
    });
};

if (window?.swup?.hooks) {
    bindSwupNavSync();
} else {
    document.addEventListener('swup:enable', bindSwupNavSync);
}
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
