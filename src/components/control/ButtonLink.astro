---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="group block">
    <button
        class:list={`
            w-full
            h-10
            rounded-xl
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all duration-200
            px-2.5
            group-hover:translate-x-1
            
            text-neutral-700
            hover:text-[var(--primary)]
            dark:text-neutral-300
            dark:hover:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between relative">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis font-medium text-sm">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition-all duration-200 px-2.5 h-6 ml-3 min-w-[1.75rem] rounded-full text-xs font-bold
                    text-[var(--btn-content)] dark:text-[var(--deep-text)]
                    bg-[var(--btn-regular-bg)] dark:bg-[var(--primary)]
                    group-hover:scale-105 group-hover:bg-[var(--primary)] group-hover:text-white
                    flex items-center justify-center shadow-sm">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
