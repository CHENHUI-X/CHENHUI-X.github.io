---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<div class:list={[className, "flex flex-row gap-2.5 justify-center items-center"]} style={style}>
    <a href={page.url.prev || ""} aria-label={page.url.prev ? "Previous Page" : null}
       class:list={["card-base btn-card overflow-hidden rounded-[var(--radius-btn)] text-[var(--primary)] w-10 h-10 hover:-translate-y-0.5 active:scale-95",
           {"disabled": page.url.prev == undefined}
       ]}
    >
        <Icon name="material-symbols:chevron-left-rounded" class="text-[1.5rem]"></Icon>
    </a>
    <div class="card-base flex flex-row rounded-[var(--radius-btn)] items-center text-neutral-700 dark:text-neutral-300 font-bold tabular-nums p-0.5 gap-0.5">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <Icon name="material-symbols:more-horiz" class="mx-1.5 text-black/40 dark:text-white/40"/>;
            if (p == page.currentPage)
                return <div class="h-9 w-9 rounded-[0.5rem] bg-[var(--primary)] flex items-center justify-center
                    font-bold text-white shadow-sm"
                >
                    {p}
                </div>
            return <a href={url(getPageUrl(p))} aria-label={`Page ${p}`}
                class="flex items-center justify-center w-9 h-9 rounded-[0.5rem] overflow-hidden hover:bg-[var(--btn-plain-bg-hover)] active:scale-[0.9] hover:text-[var(--primary)] transition-[color,background-color,transform] duration-180"
            >{p}</a>
        })}
    </div>
    <a href={page.url.next || ""} aria-label={page.url.next ? "Next Page" : null}
       class:list={["card-base btn-card overflow-hidden rounded-[var(--radius-btn)] text-[var(--primary)] w-10 h-10 hover:-translate-y-0.5 active:scale-95",
           {"disabled": page.url.next == undefined}
       ]}
    >
        <Icon name="material-symbols:chevron-right-rounded" class="text-[1.5rem]"></Icon>
    </a>
</div>