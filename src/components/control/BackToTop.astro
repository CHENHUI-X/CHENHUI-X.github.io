---
import { Icon } from "astro-icon/components";
---

<div id="nav-buttons-wrapper" class="nav-buttons-wrapper">
	<button id="back-to-top-btn" type="button" class="nav-fab hide" onclick="backToTop()" aria-label="回到顶部">
		<svg class="fab-ring-svg" viewBox="0 0 44 44" aria-hidden="true">
			<circle class="fab-ring-track" cx="22" cy="22" r="19" />
			<circle id="fab-progress-ring" class="fab-ring-fill" cx="22" cy="22" r="19" />
		</svg>
		<Icon name="material-symbols:keyboard-arrow-up-rounded" class="fab-icon" />
	</button>
	<button id="go-to-bottom-btn" type="button" class="nav-fab hide" onclick="goToBottom()" aria-label="直达底部或评论">
		<Icon name="material-symbols:keyboard-arrow-down-rounded" class="fab-icon" />
	</button>
</div>

<style>
.nav-buttons-wrapper {
	position: fixed;
	right: 1.5rem;
	bottom: 2.5rem;
	display: none;
	flex-direction: column;
	gap: 0.65rem;
	z-index: 60;
	pointer-events: none;
}

@media (min-width: 1024px) {
	.nav-buttons-wrapper {
		display: flex;
	}
}

.nav-fab {
	pointer-events: auto;
	width: 2.75rem;
	height: 2.75rem;
	padding: 0;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	position: relative;
	color: var(--primary);
	font-size: 1.45rem;
	user-select: none;
	-webkit-tap-highlight-color: transparent;
	background: rgba(255, 255, 255, 0.86);
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
	border: 1px solid rgba(255, 255, 255, 0.72);
	box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
	/* 纯 GPU transform + opacity，零 margin 重排 */
	transform: translateY(0) scale(1);
	opacity: 0.92;
	transition:
		transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
		opacity 220ms ease,
		box-shadow 240ms ease,
		background-color 200ms ease,
		border-color 200ms ease;
}

.nav-fab:hover {
	transform: translateY(-2.5px) scale(1.06);
	opacity: 1;
	background: rgba(255, 255, 255, 0.96);
	border-color: color-mix(in oklab, var(--primary) 40%, transparent);
	box-shadow: 0 8px 24px -2px rgba(0, 0, 0, 0.12);
}

.nav-fab:active {
	transform: translateY(0) scale(0.94);
}

.nav-fab.hide {
	transform: translateY(12px) scale(0.88);
	opacity: 0;
	pointer-events: none;
}

.fab-ring-svg {
	position: absolute;
	inset: -1px;
	width: calc(100% + 2px);
	height: calc(100% + 2px);
	transform: rotate(-90deg);
	pointer-events: none;
}

.fab-ring-track {
	fill: none;
	stroke: rgba(128, 128, 128, 0.12);
	stroke-width: 2;
}

.fab-ring-fill {
	fill: none;
	stroke: var(--primary);
	stroke-width: 2.2;
	stroke-linecap: round;
	stroke-dasharray: 119.38;
	stroke-dashoffset: 119.38;
}

.fab-icon {
	position: relative;
	z-index: 1;
}

:global(:root.dark) .nav-fab {
	background: rgba(30, 22, 42, 0.85);
	border-color: rgba(255, 255, 255, 0.08);
	box-shadow: 0 4px 16px rgba(0, 0, 0, 0.32);
}

:global(:root.dark) .nav-fab:hover {
	background: rgba(42, 30, 58, 0.95);
	border-color: color-mix(in oklab, var(--primary) 45%, transparent);
	box-shadow: 0 8px 26px rgba(0, 0, 0, 0.48);
}

:global(:root.dark) .fab-ring-track {
	stroke: rgba(255, 255, 255, 0.08);
}
</style>

<script is:raw is:inline>
function backToTop() {
	window.scroll({ top: 0, behavior: 'smooth' });
}

function goToBottom() {
	var waline = document.getElementById('waline-container');
	if (waline) {
		waline.scrollIntoView({ behavior: 'smooth', block: 'start' });
	} else {
		window.scroll({ top: document.body.scrollHeight, behavior: 'smooth' });
	}
}
</script>
