---
import { getArticleTopic } from "@constants/article-topics";
import { getMemorySeriesNavigation } from "@constants/memory-series";

interface Props {
	slug: string;
}
const { slug } = Astro.props;
const series = getMemorySeriesNavigation(slug);
const topic = getArticleTopic(slug);
const article = topic?.articles.find((item) => item.slug === slug);
---
{topic && article && <aside class="mb-6 p-4 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/[0.08] border-l-4 !border-l-[var(--primary)] text-sm shadow-sm transition hover:shadow-md" aria-label="文章定位" data-article-context>
    <p class="mb-2 text-black/60 dark:text-white/60">本文位置：<a class="text-[var(--primary)] font-medium hover:underline" href={`/topics/#${topic.id}`}>{topic.title}</a> · <a class="text-[var(--primary)] font-medium hover:underline" href="/topics/">全站主题目录</a></p>
    {series && <p class="mb-2 text-black/60 dark:text-white/60" data-series-position>显存系列第 {series.position} / {series.total} 篇 · <a class="text-[var(--primary)] font-medium hover:underline" href="/topics/#llm-memory">查看系列顺序</a></p>}
    <p class="text-black/80 dark:text-white/80 leading-relaxed">{article.purpose}</p>
</aside>}
