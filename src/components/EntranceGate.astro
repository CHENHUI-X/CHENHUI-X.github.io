<script>
	async function bootEntranceGate() {
		const gateEl = document.getElementById("entrance-gate");
		if (!gateEl) return;

		let mounted = false;
		const dismissFailsafe = () => {
			if (mounted) return;
			try {
				localStorage.setItem("chenhui_gate_seen", "1");
			} catch (_) {}
			document.documentElement.classList.remove(
				"has-entrance-gate",
				"gate-revealing",
			);
			gateEl.setAttribute("aria-hidden", "true");
			gateEl.style.display = "none";
		};

		for (const btn of gateEl.querySelectorAll("[data-eg-open]")) {
			btn.addEventListener("click", dismissFailsafe);
		}

		const mountIfActive = async () => {
			if (!document.documentElement.classList.contains("has-entrance-gate")) {
				return;
			}
			const rawMeta = gateEl.dataset.gateMeta;
			const meta = rawMeta
				? JSON.parse(rawMeta)
				: {
						postCount: 28,
						topicCount: 7,
						tagCount: 24,
						lastUpdated: "2026-06-16",
						siteTitle: "CHENHUI · 格物",
					};
			try {
				const { initEntranceGate } = await import("../scripts/entrance-gate");
				mounted = true;
				initEntranceGate(gateEl, meta);
			} catch (_) {
				dismissFailsafe();
			}
		};

		// Expose helper to replay the entrance gate on demand if desired
		window.__openEntranceGate = () => {
			gateEl.style.display = "";
			gateEl.removeAttribute("aria-hidden");
			gateEl.classList.remove("is-shattering", "is-webgl-ready", "is-fallback");
			const backdrop = gateEl.querySelector<HTMLElement>("#eg-backdrop");
			if (backdrop) backdrop.style.opacity = "1";
			const canvasEl = gateEl.querySelector<HTMLElement>("#eg-canvas");
			if (canvasEl) {
				canvasEl.style.transition = "";
				canvasEl.style.opacity = "";
			}
			const shockEl = gateEl.querySelector<HTMLElement>("#eg-shockwave");
			if (shockEl) shockEl.classList.remove("is-burst");
			const fallbackEl = gateEl.querySelector<HTMLElement>("#eg-fallback");
			if (fallbackEl) {
				fallbackEl.style.display = "";
				fallbackEl.style.opacity = "";
			}
			document.documentElement.classList.add("has-entrance-gate");
			void mountIfActive();
		};

		if (document.documentElement.classList.contains("has-entrance-gate")) {
			requestAnimationFrame(() => {
				void mountIfActive();
			});
		}
	}

	void bootEntranceGate();
</script>
