---
import { getArticleTopic } from "@constants/article-topics";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	slug: string;
}
const topic = getArticleTopic(Astro.props.slug);
const related =
	topic?.articles.filter((item) => item.slug !== Astro.props.slug) ?? [];
---
{topic && (
    <nav class="card-base p-6 md:px-9 mb-4" aria-label="同主题文章" data-topic-navigation>
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-[var(--border-subtle)]">
            <div class="flex items-center gap-2">
                <span class="w-1 h-4 rounded-full bg-[var(--primary)]"></span>
                <p class="font-bold text-black/85 dark:text-white/85">{topic.title} · 同专题选读</p>
            </div>
            <a class="btn-tonal px-3 py-1 rounded-full text-xs font-semibold hover:bg-[var(--primary)] hover:text-white hover:border-transparent" href="/topics/">
                ← 全站主题目录
            </a>
        </div>
        <ul class="grid gap-2.5 sm:grid-cols-2">
            {related.map((article) => (
                <li>
                    <a
                        class="group flex items-start justify-between gap-2 p-3.5 rounded-[var(--radius-inner)] border border-[var(--border-subtle)] bg-black/[0.015] dark:bg-white/[0.02] hover:bg-[var(--btn-plain-bg-hover)] hover:border-[var(--primary)]/35 transition-[transform,background-color,border-color] duration-220 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 h-full"
                        href={getPostUrlBySlug(article.slug)}
                    >
                        <div class="min-w-0">
                            <div class="font-bold text-sm text-black/85 dark:text-white/85 group-hover:text-[var(--primary)] transition-colors line-clamp-1">
                                {article.title}
                            </div>
                            <p class="text-xs text-black/50 dark:text-white/50 mt-1 line-clamp-1">
                                {article.purpose}
                            </p>
                        </div>
                        <Icon name="material-symbols:chevron-right-rounded" class="text-lg text-black/25 dark:text-white/25 group-hover:text-[var(--primary)] group-hover:translate-x-0.5 transition-[transform,color] duration-200 shrink-0 mt-0.5" />
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}
