---
import { Icon } from "astro-icon/components";

const { title, url } = Astro.props;

const urlStr = typeof url === "string" ? url : url.toString();
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(urlStr);
const fullText = `${encodedTitle}%0A${encodedUrl}`;
const qrSrc = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodedUrl}`;

const shareLinks = [
	{
		name: "Twitter",
		icon: "fa6-brands:square-x-twitter",
		href: `https://twitter.com/intent/tweet?text=${fullText}`,
	},
	{
		name: "Facebook",
		icon: "fa6-brands:facebook",
		href: `https://www.facebook.com/sharer/sharer.php?title=${encodedTitle}&u=${encodedUrl}`,
	},
	{
		name: "Telegram",
		icon: "fa6-brands:telegram",
		href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
	},
	{
		name: "WeChat",
		icon: "fa6-brands:weixin",
		wechat: true,
	},
];
---

<div class="share-buttons flex flex-wrap items-center gap-2 mt-6 pt-5 border-t border-dashed border-[var(--line-divider)]">
	<span class="text-sm text-[var(--secondary)] mr-1">分享</span>
	<button
		type="button"
		id="copy-link-btn"
		class="btn-tonal h-9 px-3 gap-1.5 text-xs font-semibold cursor-pointer hover:-translate-y-0.5 hover:bg-[var(--primary)] hover:text-white hover:border-transparent"
		title="复制文章链接"
		aria-label="复制文章链接"
	>
		<Icon name="material-symbols:link-rounded" class="text-[1.05rem] copy-link-icon" />
		<Icon name="material-symbols:check-rounded" class="text-[1.05rem] hidden copy-link-ok" />
		<span data-copy-label>复制链接</span>
	</button>
	{shareLinks.map((link) =>
		link.wechat ? (
			<button
				type="button"
				id="wechat-share-btn"
				class="btn-tonal h-9 w-9 cursor-pointer hover:-translate-y-0.5 hover:bg-[var(--primary)] hover:text-white hover:border-transparent"
				title="WeChat"
				aria-label="Share to WeChat"
				onclick="document.getElementById('wechat-overlay').style.display='flex'"
			>
				<Icon name={link.icon} class="text-[1.15rem]" />
			</button>
		) : (
			<a
				href={link.href}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-tonal h-9 w-9 hover:-translate-y-0.5 hover:bg-[var(--primary)] hover:text-white hover:border-transparent"
				title={link.name}
				aria-label={`Share to ${link.name}`}
			>
				<Icon name={link.icon} class="text-[1.15rem]" />
			</a>
		)
	)}
</div>

<div id="wechat-overlay"
	style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,0.52);align-items:center;justify-content:center"
	onclick="this.style.display='none'"
>
	<div
		class="rounded-2xl p-6 shadow-2xl flex flex-col items-center min-w-[260px]"
		style="background:var(--surface-elevated);border:1px solid var(--border-subtle);color:var(--text-90)"
		onclick="event.stopPropagation()"
	>
		<div class="text-sm font-semibold mb-3">
			微信扫码分享
		</div>
		<div class="bg-white p-3 rounded-xl border border-black/5">
			<img
				src={qrSrc}
				alt="QR Code"
				width="200"
				height="200"
				style="display:block"
				loading="lazy"
			/>
		</div>
		<p class="mt-2.5 text-xs text-[var(--secondary)] break-all max-w-[240px] text-center select-all">
			{urlStr}
		</p>
		<button
			type="button"
			class="btn-tonal mt-3.5 px-4 h-8 text-xs font-medium cursor-pointer"
			onclick="document.getElementById('wechat-overlay').style.display='none'"
		>
			关闭
		</button>
	</div>
</div>

<script>
let copyTimer: ReturnType<typeof setTimeout> | undefined;

function bindShareControls() {
	const overlay = document.getElementById("wechat-overlay");
	// Remove stale overlay from previous Swup navigation
	const stale = document.body.querySelectorAll("#wechat-overlay");
	stale.forEach((el) => {
		if (el !== overlay) el.remove();
	});
	if (overlay && overlay.parentElement !== document.body) {
		document.body.appendChild(overlay);
	}

	const copyBtn = document.getElementById("copy-link-btn");
	if (copyBtn && !copyBtn.dataset.bound) {
		copyBtn.dataset.bound = "1";
		copyBtn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
			} catch {
				// fallback for restricted contexts
				const ta = document.createElement("textarea");
				ta.value = window.location.href;
				ta.style.position = "fixed";
				ta.style.opacity = "0";
				document.body.appendChild(ta);
				ta.select();
				document.execCommand("copy");
				ta.remove();
			}
			const label = copyBtn.querySelector<HTMLElement>("[data-copy-label]");
			const iconLink = copyBtn.querySelector<HTMLElement>(".copy-link-icon");
			const iconOk = copyBtn.querySelector<HTMLElement>(".copy-link-ok");
			if (label) label.textContent = "已复制";
			iconLink?.classList.add("hidden");
			iconOk?.classList.remove("hidden");
			copyBtn.classList.add("!bg-[var(--primary)]", "!text-white", "!border-transparent");
			clearTimeout(copyTimer);
			copyTimer = setTimeout(() => {
				if (label) label.textContent = "复制链接";
				iconLink?.classList.remove("hidden");
				iconOk?.classList.add("hidden");
				copyBtn.classList.remove("!bg-[var(--primary)]", "!text-white", "!border-transparent");
			}, 1800);
		});
	}
}

bindShareControls();
if (!(window as any).__shareEscBound) {
	(window as any).__shareEscBound = true;
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			const overlay = document.getElementById("wechat-overlay");
			if (overlay) overlay.style.display = "none";
		}
	});
}
const setup = () => {
	if (window.swup) {
		window.swup.hooks.on("page:view", bindShareControls);
	}
};
if (window.swup) {
	setup();
} else {
	document.addEventListener("swup:enable", setup);
}
</script>
