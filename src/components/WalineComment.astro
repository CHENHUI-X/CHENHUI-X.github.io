---
const { postEntry } = Astro.props;
const slug = postEntry.slug;
---

<div id="waline-container" class="waline-wrapper" data-slug={slug}>
	<!-- 加载骨架屏：在 Waline 初始化前展示 -->
	<div id="waline-loading" class="waline-loading">
		<div class="wl-skeleton">
			<div class="wl-skeleton-header">
				<div class="wl-skeleton-avatar"></div>
				<div class="wl-skeleton-input"></div>
			</div>
			<div class="wl-skeleton-comments">
				<div class="wl-skeleton-item">
					<div class="wl-skeleton-avatar-sm"></div>
					<div class="wl-skeleton-body">
						<div class="wl-skeleton-line wl-skeleton-line--short"></div>
						<div class="wl-skeleton-line wl-skeleton-line--medium"></div>
						<div class="wl-skeleton-line wl-skeleton-line--long"></div>
					</div>
				</div>
				<div class="wl-skeleton-item">
					<div class="wl-skeleton-avatar-sm"></div>
					<div class="wl-skeleton-body">
						<div class="wl-skeleton-line wl-skeleton-line--short"></div>
						<div class="wl-skeleton-line wl-skeleton-line--medium"></div>
					</div>
				</div>
				<div class="wl-skeleton-item">
					<div class="wl-skeleton-body wl-skeleton-body--offset">
						<div class="wl-skeleton-line wl-skeleton-line--short"></div>
						<div class="wl-skeleton-line wl-skeleton-line--long"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
(function () {
	var walineCssLoaded = false;
	var walineObserver: IntersectionObserver | null = null;

	function ensureWalineCss() {
		if (walineCssLoaded || document.getElementById("waline-css-link")) {
			walineCssLoaded = true;
			return;
		}
		walineCssLoaded = true;
		var link = document.createElement("link");
		link.id = "waline-css-link";
		link.rel = "stylesheet";
		link.href = "https://cdn.jsdelivr.net/npm/@waline/client@3/dist/waline.css";
		document.head.appendChild(link);
	}

	function hideLoading() {
		var el = document.getElementById("waline-loading");
		if (el) {
			el.classList.add("wl-loading-done");
			setTimeout(function () {
				el!.style.display = "none";
			}, 300);
		}
	}

	// 乐观更新拦截：避免 Waline reaction 投票串行等待海外 Vercel 慢网络往返（导致转圈等待数秒）
	if (typeof window !== "undefined" && !(window as any).__waline_fetch_patched) {
		(window as any).__waline_fetch_patched = true;
		const originalFetch = window.fetch.bind(window);
		window.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
			let url = "";
			let method = "GET";
			let bodyStr = "";

			if (typeof input === "string") {
				url = input;
				method = init?.method || "GET";
			} else if (input instanceof URL) {
				url = input.toString();
				method = init?.method || "GET";
			} else if (input && typeof input === "object" && "url" in input) {
				url = (input as Request).url;
				method = init?.method || (input as Request).method || "GET";
			}

			if (init && typeof init.body === "string") {
				bodyStr = init.body;
			}

			// 拦截表情投票请求（POST /article 包含 reaction 参数）
			const isReactionPost =
				method.toUpperCase() === "POST" &&
				url.includes("/article") &&
				bodyStr.includes("reaction");

			if (isReactionPost) {
				// 后台静默异步同步至云端数据库（持久化保存）
				originalFetch(input, init).catch((err) => {
					console.warn("[Waline] reaction background sync failed:", err);
				});
				// 前端立即返回成功响应，实现 0ms 瞬间反馈，彻底消除转圈等待延迟
				return Promise.resolve(
					new Response("1", {
						status: 200,
						headers: { "Content-Type": "application/json" },
					}),
				);
			}

			return originalFetch(input, init);
		};
	}

	function mountWalineNow(container: HTMLElement) {
		if (container.dataset.walineMounted === "1") return;
		if (container.querySelector(".wl-panel")) {
			hideLoading();
			return;
		}
		container.dataset.walineMounted = "1";
		ensureWalineCss();

		var slug = container.getAttribute("data-slug") || "";

		import("@waline/client").then(function (mod) {
			// 若用户在异步加载完成前已切走页面，直接放弃挂载
			if (!document.body.contains(container)) return;
			mod.init({
				el: "#waline-container",
				serverURL: "https://waline-comment-smoky.vercel.app",
				path: "/" + slug,
				lang: "zh-CN",
				reaction: true,
				pageview: true,
				dark: "html.dark",
				requiredMeta: ["nick", "mail"],
			});
			// 检测 Waline 渲染完毕就隐藏骨架
			var checkLoaded = setInterval(function () {
				var el = document.getElementById("waline-container");
				if (el && el.querySelector(".wl-panel")) {
					clearInterval(checkLoaded);
					hideLoading();
				}
			}, 120);
			setTimeout(function () {
				clearInterval(checkLoaded);
				hideLoading();
			}, 10000);
		});
	}

	// 视口接近懒加载：打开长文章首帧不抢占主线程与网络，滚动到距离评论区 600px 内自动提前挂载
	function observeWaline() {
		if (walineObserver) {
			walineObserver.disconnect();
			walineObserver = null;
		}
		var container = document.getElementById("waline-container");
		if (!container) return;
		if (container.querySelector(".wl-panel")) {
			hideLoading();
			return;
		}
		if ("IntersectionObserver" in window) {
			walineObserver = new IntersectionObserver(
				function (entries) {
					for (var i = 0; i < entries.length; i++) {
						if (entries[i].isIntersecting) {
							walineObserver?.disconnect();
							walineObserver = null;
							mountWalineNow(container!);
							break;
						}
					}
				},
				{ rootMargin: "600px 0px" },
			);
			walineObserver.observe(container);
		} else {
			setTimeout(function () {
				mountWalineNow(container!);
			}, 600);
		}
	}

	// Swup 导航
	if (window.swup) {
		window.swup.hooks.on("page:view", observeWaline);
	} else {
		document.addEventListener("swup:enable", function () {
			window.swup.hooks.on("page:view", observeWaline);
		});
	}

	observeWaline();
})();
</script>

<style>
.waline-wrapper {
	margin-top: 2rem;
	width: 100%;
}

/* ── 全局 Waline 主题色与样式美化 ── */
:global(#waline-container) {
	--waline-theme-color: var(--primary) !important;
	--waline-active-color: var(--primary) !important;
	--waline-badge-color: var(--primary) !important;
	--waline-border-color: rgba(128, 128, 128, 0.12) !important;
	--waline-avatar-radius: 50% !important;
}

/* ── 1. 表情投票卡片（Reaction Widget）统一卡片容器与胶囊按钮 ── */
:global(#waline-container .wl-reaction) {
	margin: 2rem auto 1.5rem !important;
	padding: 1.25rem !important;
	background: var(--surface-card) !important;
	border: 1px solid var(--border-subtle) !important;
	border-radius: var(--radius-large) !important;
	box-shadow: var(--card-highlight), 0 4px 16px -4px rgba(15, 23, 42, 0.05) !important;
	max-width: 38rem !important;
	text-align: center !important;
	overflow: visible !important;
}
:global(:root.dark #waline-container .wl-reaction) {
	background: var(--surface-card) !important;
	border: 1px solid var(--border-subtle) !important;
	box-shadow: var(--card-highlight), 0 6px 20px rgba(0, 0, 0, 0.28) !important;
}
:global(#waline-container .wl-reaction-title) {
	font-size: 0.92rem !important;
	font-weight: 600 !important;
	margin: 0 0 1rem !important;
	color: var(--text-90) !important;
	letter-spacing: 0.02em !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	gap: 0.5rem !important;
}
:global(#waline-container .wl-reaction-list) {
	display: flex !important;
	flex-wrap: wrap !important;
	justify-content: center !important;
	gap: 0.6rem !important;
	padding: 0 !important;
	margin: 0 !important;
	overflow: visible !important;
}
:global(#waline-container .wl-reaction-item) {
	display: flex !important;
	flex-direction: column !important;
	align-items: center !important;
	justify-content: center !important;
	padding: 0.6rem 0.75rem 0.5rem !important;
	min-width: 4rem !important;
	border-radius: var(--radius-inner) !important;
	background: rgba(128, 128, 128, 0.04) !important;
	border: 1px solid var(--border-subtle) !important;
	cursor: pointer !important;
	transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), background-color 180ms ease, border-color 180ms ease, box-shadow 220ms ease !important;
}
:global(:root.dark #waline-container .wl-reaction-item) {
	background: rgba(255, 255, 255, 0.03) !important;
	border: 1px solid var(--border-subtle) !important;
}
:global(#waline-container .wl-reaction-item:hover) {
	transform: translateY(-2px) !important;
	background: var(--surface-card-hover) !important;
	border-color: var(--primary) !important;
	box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06) !important;
}
:global(:root.dark #waline-container .wl-reaction-item:hover) {
	background: var(--surface-card-hover) !important;
	border-color: var(--primary) !important;
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.34) !important;
}
:global(#waline-container .wl-reaction-item:active) {
	transform: translateY(0) scale(0.96) !important;
}
:global(#waline-container .wl-reaction-img) {
	display: flex !important;
	flex-direction: column !important;
	align-items: center !important;
	justify-content: center !important;
	width: auto !important;
	height: auto !important;
	position: static !important;
}
:global(#waline-container .wl-reaction-img img) {
	width: 36px !important;
	height: 36px !important;
	margin-bottom: 0.35rem !important;
	object-fit: contain !important;
	transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1) !important;
}
:global(#waline-container .wl-reaction-item:hover .wl-reaction-img img) {
	transform: scale(1.08) !important;
}
:global(#waline-container .wl-reaction-votes) {
	position: static !important;
	inset: auto !important;
	min-width: 1.5rem !important;
	height: 1.15rem !important;
	padding: 0 6px !important;
	font-size: 0.72rem !important;
	font-weight: 700 !important;
	font-variant-numeric: tabular-nums !important;
	border-radius: 9999px !important;
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;
	background: rgba(128, 128, 128, 0.08) !important;
	border: 1px solid var(--border-subtle) !important;
	color: var(--text-75) !important;
	box-shadow: none !important;
	transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease !important;
}
:global(:root.dark #waline-container .wl-reaction-votes) {
	background: rgba(255, 255, 255, 0.06) !important;
	border-color: var(--border-subtle) !important;
	color: var(--text-75) !important;
}
:global(#waline-container .wl-reaction-item:hover .wl-reaction-votes),
:global(#waline-container .wl-reaction-item.active .wl-reaction-votes) {
	background: var(--primary) !important;
	border-color: var(--primary) !important;
	color: #ffffff !important;
}
:global(#waline-container .wl-reaction-item.active) {
	border-color: var(--primary) !important;
	box-shadow: 0 0 0 1px var(--primary), 0 4px 12px rgba(15, 23, 42, 0.06) !important;
}
:global(#waline-container .wl-reaction-loading) {
	position: static !important;
	inset: auto !important;
	width: 1rem !important;
	height: 1.15rem !important;
	min-width: 1.5rem !important;
	color: var(--primary) !important;
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;
	animation: wl-reaction-spin 0.8s linear infinite !important;
}
@keyframes wl-reaction-spin {
	from {
		transform: rotate(0deg);
	}
	to {
		transform: rotate(360deg);
	}
}

/* ── 2. 评论主输入框（Panel & Editor）统一卡片外观 ── */
:global(#waline-container .wl-panel) {
	margin: 1.5rem 0 2rem !important;
	border-radius: var(--radius-large) !important;
	border: 1px solid var(--border-subtle) !important;
	background: var(--surface-card) !important;
	box-shadow: var(--card-highlight), 0 4px 18px -4px rgba(15, 23, 42, 0.05) !important;
	overflow: hidden !important;
	transition: border-color 220ms ease, box-shadow 220ms ease !important;
}
:global(:root.dark #waline-container .wl-panel) {
	background: var(--surface-card) !important;
	border: 1px solid var(--border-subtle) !important;
	box-shadow: var(--card-highlight), 0 6px 20px rgba(0, 0, 0, 0.28) !important;
}
:global(#waline-container .wl-panel:focus-within) {
	border-color: var(--primary) !important;
	box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08), 0 0 0 1px var(--primary) !important;
}

/* ── 3. 移除廉价虚线，改用细致微边框 ── */
:global(#waline-container .wl-header) {
	border-bottom: 1px solid var(--border-subtle) !important;
	background: rgba(128, 128, 128, 0.025) !important;
	padding: 0.25rem 0.5rem !important;
}
:global(#waline-container .wl-header-item) {
	border-bottom: none !important;
	border-right: 1px solid var(--border-subtle) !important;
}
:global(#waline-container .wl-header-item:last-child) {
	border-right: none !important;
}
@media (max-width: 640px) {
	:global(#waline-container .wl-header) {
		flex-direction: column !important;
	}
	:global(#waline-container .wl-header-item) {
		border-right: none !important;
		border-bottom: 1px solid rgba(128, 128, 128, 0.08) !important;
	}
	:global(#waline-container .wl-header-item:last-child) {
		border-bottom: none !important;
	}
}
:global(#waline-container .wl-header label) {
	font-size: 0.8rem !important;
	font-weight: 600 !important;
	color: var(--primary) !important;
	opacity: 0.85 !important;
}
:global(#waline-container .wl-input) {
	font-size: 0.875rem !important;
	color: inherit !important;
	padding: 0.5rem 0.75rem !important;
	background: transparent !important;
}
:global(#waline-container .wl-editor) {
	padding: 1rem 1.25rem !important;
	font-size: 0.95rem !important;
	line-height: 1.7 !important;
	background: transparent !important;
	color: inherit !important;
	min-height: 7.5rem !important;
}
:global(#waline-container .wl-editor:focus) {
	background: transparent !important;
}

/* ── 4. 底部工具栏与按钮统一规范 ── */
:global(#waline-container .wl-footer) {
	border-top: 1px solid var(--border-subtle) !important;
	background: rgba(128, 128, 128, 0.02) !important;
	padding: 0.6rem 1rem !important;
	align-items: center !important;
}
:global(#waline-container .wl-action) {
	width: 2rem !important;
	height: 2rem !important;
	border-radius: 0.5rem !important;
	transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background-color 180ms ease, color 180ms ease !important;
	color: var(--text-50) !important;
}
:global(#waline-container .wl-action:hover) {
	background: rgba(128, 128, 128, 0.08) !important;
	color: var(--primary) !important;
	transform: translateY(-1px) scale(1.06) !important;
}
:global(#waline-container .wl-btn) {
	border-radius: var(--radius-btn) !important;
	padding: 0.42rem 1.1rem !important;
	font-weight: 600 !important;
	font-size: 0.85rem !important;
	transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), background-color 180ms ease, border-color 180ms ease, color 180ms ease, filter 180ms ease !important;
}
:global(#waline-container .wl-btn:not(.primary)) {
	border: 1px solid var(--border-strong) !important;
	background: transparent !important;
	color: inherit !important;
}
:global(#waline-container .wl-btn:not(.primary):hover) {
	border-color: var(--primary) !important;
	color: var(--primary) !important;
	background: rgba(128, 128, 128, 0.06) !important;
	transform: translateY(-1px) !important;
}
:global(#waline-container .wl-btn.primary) {
	background: var(--primary) !important;
	border: none !important;
	color: #ffffff !important;
	box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 4px 12px -4px color-mix(in oklab, var(--primary) 45%, transparent) !important;
}
:global(#waline-container .wl-btn.primary:hover) {
	transform: translateY(-1px) !important;
	filter: brightness(1.06) !important;
}
:global(#waline-container .wl-btn.primary:active) {
	transform: translateY(0) scale(0.97) !important;
}

/* ── 5. 排序选项与统计头 ── */
:global(#waline-container .wl-meta-head) {
	display: flex !important;
	align-items: center !important;
	margin-bottom: 1rem !important;
	padding-bottom: 0.75rem !important;
	border-bottom: 1px solid var(--border-subtle) !important;
}
:global(#waline-container .wl-count) {
	font-size: 1.15rem !important;
	font-weight: 700 !important;
	font-variant-numeric: tabular-nums !important;
}
:global(#waline-container .wl-sort li) {
	padding: 0.25rem 0.75rem !important;
	border-radius: 9999px !important;
	font-size: 0.8rem !important;
	font-weight: 500 !important;
	cursor: pointer !important;
	transition: background-color 180ms ease, color 180ms ease !important;
	color: var(--text-50) !important;
}
:global(#waline-container .wl-sort li:hover) {
	color: var(--primary) !important;
}
:global(#waline-container .wl-sort li.active) {
	background: var(--primary) !important;
	color: #ffffff !important;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1) !important;
}

/* ── 6. 评论卡片细节 ── */
:global(#waline-container .wl-card) {
	padding: 1.25rem 0 !important;
	border-bottom: 1px solid var(--border-subtle) !important;
}
:global(#waline-container .wl-user) {
	font-weight: 600 !important;
	font-size: 0.95rem !important;
}
:global(#waline-container .wl-badge) {
	border-radius: 9999px !important;
	font-size: 0.7rem !important;
	padding: 0.1rem 0.55rem !important;
	background: var(--primary) !important;
	border-color: var(--primary) !important;
	color: #ffffff !important;
	box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08) !important;
}
:global(#waline-container .wl-time) {
	font-size: 0.78rem !important;
	opacity: 0.55 !important;
}
:global(#waline-container .wl-content) {
	font-size: 0.95rem !important;
	line-height: 1.75 !important;
	margin-top: 0.5rem !important;
}
:global(#waline-container .wl-reply) {
	color: var(--primary) !important;
	font-weight: 500 !important;
	font-size: 0.825rem !important;
	transition: transform 0.2s ease !important;
}
:global(#waline-container .wl-reply:hover) {
	transform: scale(1.08) !important;
}

/* ── 加载骨架屏 ── */
.wl-skeleton {
	padding: 1.5rem;
	border-radius: 1rem;
	background: rgba(255, 255, 255, 0.78);
}
:root.dark .wl-skeleton {
	background: rgba(30, 20, 40, 0.72);
}

@keyframes wl-pulse {
	0%, 100% { opacity: 0.3; }
	50% { opacity: 0.7; }
}
.wl-skeleton * {
	animation: wl-pulse 1.5s ease-in-out infinite;
}

.wl-skeleton-header {
	display: flex;
	gap: 0.75rem;
	align-items: flex-start;
	margin-bottom: 1.75rem;
}
.wl-skeleton-avatar {
	width: 2.75rem;
	height: 2.75rem;
	border-radius: 50%;
	background: currentColor;
	flex-shrink: 0;
}
.wl-skeleton-input {
	flex: 1;
	height: 5rem;
	border-radius: 0.75rem;
	background: currentColor;
}

.wl-skeleton-comments {
	display: flex;
	flex-direction: column;
	gap: 1.25rem;
}
.wl-skeleton-item {
	display: flex;
	gap: 0.75rem;
	align-items: flex-start;
}
.wl-skeleton-avatar-sm {
	width: 2rem;
	height: 2rem;
	border-radius: 50%;
	background: currentColor;
	flex-shrink: 0;
}
.wl-skeleton-body {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}
.wl-skeleton-body--offset {
	margin-left: 2.75rem;
}
.wl-skeleton-line {
	height: 0.8rem;
	border-radius: 0.375rem;
	background: currentColor;
}
.wl-skeleton-line--short { width: 25%; }
.wl-skeleton-line--medium { width: 55%; }
.wl-skeleton-line--long { width: 85%; }

.wl-loading-done {
	opacity: 0;
	transition: opacity 0.3s ease;
	pointer-events: none;
}
</style>
